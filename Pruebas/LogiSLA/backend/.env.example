# Copia este archivo como .env (en esta misma carpeta). El archivo .env NO se
# sube a GitHub.

# IA generativa (carta de reclamo y resumen ejecutivo).
# Se intenta primero con la IA principal; si no tiene clave, se agotó su
# cuota o saldo, o no responde, redacta la de respaldo; si tampoco, se usa la
# plantilla fija. IA_PRINCIPAL: gemini (por defecto) o claude.
IA_PRINCIPAL=gemini

# Gemini (gratuita). Clave en https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=25

# Claude (opcional, de pago). Clave en https://platform.claude.com
# Requiere créditos prepagados. Sin clave, simplemente no se usa.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_TIMEOUT_S=30

# Base de datos. Sin esta línea, iniciar.bat usa su PostgreSQL integrado
# (C:\LogiSLA\pgsql). Úsala solo para conectar otro PostgreSQL, por ejemplo
# el de "docker compose up -d" en esta carpeta:
# DATABASE_URL=postgresql+psycopg2://logisla:logisla@localhost:5432/logisla

MAX_UPLOAD_SIZE_MB=25
